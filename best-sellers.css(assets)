/* ============================================================
   BEST SELLERS — Section Stylesheet
   ============================================================ */

.bs-section *,
.bs-section *::before,
.bs-section *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── Section ─────────────────────────────────────────────── */
.bs-section {
  background-color: var(--bs-bg, #faf9f6);
  padding-top: var(--bs-pt, 72px);
  padding-bottom: var(--bs-pb, 80px);
  width: 100%;
  overflow: hidden;
}

/* ── Container ───────────────────────────────────────────── */
.bs-container {
  max-width: 1500px;
  margin: 0 auto;
  padding: 0 40px;
}

/* ── Admin-only Warning Banner (theme editor only) ──────────
   Rendered only when request.design_mode is true, so this never
   ships to customers — purely a merchant-facing guardrail. ── */
.bs-admin-warning {
  max-width: 1500px;
  margin: 0 auto 24px;
  padding: 14px 20px;
  background-color: #fff4e5;
  border: 1px solid #f0c987;
  border-radius: 6px;
  font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 13px;
  line-height: 1.5;
  color: #6b4a12;
}

.bs-admin-warning__note {
  display: block;
  margin-top: 4px;
  font-size: 11.5px;
  color: #8a6a2f;
  font-style: italic;
}

/* ── Header ──────────────────────────────────────────────── */
.bs-header {
  text-align: center;
  margin-bottom: 48px;
}

.bs-heading {
  display: inline-block;
  font-family: 'Cormorant Garamond', 'Playfair Display', 'EB Garamond', Georgia, serif;
  font-size: clamp(28px, 3.5vw, 46px);
  font-weight: 400;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--bs-heading-color, #1a1a1a);
  line-height: 1.1;
  padding-bottom: 10px;
  border-bottom: 1.5px solid currentColor;
}

/* ── Grid ────────────────────────────────────────────────── */
.bs-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  list-style: none;
}

/* ── Card ────────────────────────────────────────────────── */
.bs-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: transparent;
}

/* ── Image Link ──────────────────────────────────────────── */
.bs-card__image-link {
  display: block;
  position: relative;
  overflow: hidden;
  text-decoration: none;
  aspect-ratio: 3 / 4;
  background-color: #f0eee9;
  flex-shrink: 0;
}

/* ── Images ──────────────────────────────────────────────── */
.bs-card__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
  transition:
    opacity 320ms ease,
    transform 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform, opacity;
}

.bs-card__img--primary {
  z-index: 1;
  opacity: 1;
  transform: scale(1);
}

.bs-card__img--secondary {
  z-index: 2;
  opacity: 0;
  transform: scale(1.04);
}

.bs-card__img--placeholder {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.bs-card__image-link:hover .bs-card__img--primary,
.bs-card__image-link:focus-visible .bs-card__img--primary {
  transform: scale(1.05);
}

.bs-card__image-link:hover .bs-card__img--secondary,
.bs-card__image-link:focus-visible .bs-card__img--secondary {
  opacity: 1;
  transform: scale(1.05);
}

/* ── Custom Showcase Media (replaces secondary hover image when set) ─ */
.bs-card__showcase {
  position: absolute;
  inset: 0;
  z-index: 3;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  opacity: 0;
  transform: scale(1.04);
  transition:
    opacity 420ms ease,
    transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform, opacity;
  pointer-events: none;
}

.bs-card__image-link:hover .bs-card__showcase,
.bs-card__image-link:focus-visible .bs-card__showcase {
  opacity: 1;
  transform: scale(1);
}

.bs-card__showcase-video {
  position: absolute;
  inset: 0;
  z-index: 3;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity 420ms ease;
  pointer-events: none;
}

.bs-card__image-link:hover .bs-card__showcase-video,
.bs-card__image-link:focus-visible .bs-card__showcase-video {
  opacity: 1;
}

/* Static (always-on) showcase — no hover required, used for editorial framing */
.bs-card--showcase-static .bs-card__img--primary,
.bs-card--showcase-static .bs-card__img--secondary {
  display: none;
}

.bs-card--showcase-static .bs-card__showcase {
  opacity: 1;
  transform: scale(1);
  position: absolute;
}

.bs-card--showcase-static .bs-card__image-link:hover .bs-card__showcase {
  transform: scale(1.05);
}

/* ── Badges ──────────────────────────────────────────────── */
.bs-card__badges {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 5px;
  pointer-events: none;
}

.bs-badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 12px;
  border-radius: 999px;
  font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
  line-height: 1.3;
}

.bs-badge--hot      { background-color: #fde8e8; color: #b03030; }
.bs-badge--restocked { background-color: #d6f0e8; color: #1e6648; }
.bs-badge--low      { background-color: #fde8e8; color: #b03030; }
.bs-badge--limited  { background-color: #e8e4f7; color: #4b39a1; }
.bs-badge--new      { background-color: #fef3d0; color: #a06810; }
.bs-badge--sale     { background-color: #fde8e8; color: #b03030; }
.bs-badge--default  { background-color: #eaebf0; color: #3a3a3a; }

/* ── Quick View Button ───────────────────────────────────── */
.bs-card__quickview {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 20;
  width: 38px;
  height: 38px;
  background-color: rgba(255, 255, 255, 0.94);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition:
    background-color 200ms ease,
    transform 220ms cubic-bezier(0.34, 1.4, 0.64, 1),
    opacity 250ms ease;
  opacity: 0;
  transform: translateY(-4px);
  outline: none;
}

.bs-card:hover .bs-card__quickview {
  opacity: 1;
  transform: translateY(0);
}

.bs-card__quickview:hover {
  background-color: #1a1a1a;
}

.bs-card__quickview:hover .bs-qv-icon {
  color: #fff;
}

.bs-card__quickview:focus-visible {
  outline: 2px solid #1a1a1a;
  outline-offset: 2px;
}

.bs-qv-icon {
  width: 18px;
  height: 18px;
  color: #2a2a2a;
  display: block;
  transition: color 200ms ease;
  flex-shrink: 0;
}

/* ── Product Info ────────────────────────────────────────── */
.bs-card__info {
  padding: 14px 0 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
  text-align: left;
}

.bs-card__title-link {
  text-decoration: none;
  color: inherit;
}

.bs-card__title {
  font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  color: #1a1a1a;
  line-height: 1.4;
  letter-spacing: 0.005em;
  transition: color 180ms ease;
}

.bs-card__title-link:hover .bs-card__title {
  color: #555;
}

.bs-card__vendor {
  font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 12px;
  font-weight: 400;
  color: #888;
  letter-spacing: 0.01em;
  margin-top: 1px;
}

.bs-card__price-row {
  display: flex;
  align-items: baseline;
  gap: 7px;
  margin-top: 3px;
}

.bs-card__price {
  font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  color: #1a1a1a;
  letter-spacing: 0.01em;
}

.bs-card__compare-price {
  font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 12.5px;
  font-weight: 400;
  color: #aaa;
  text-decoration: line-through;
}

.bs-card__low-stock {
  font-family: 'DM Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 12px;
  font-weight: 500;
  color: #d93025;
  margin-top: 2px;
  letter-spacing: 0.01em;
}

/* ── Quick View Modal ────────────────────────────────────── */
.bs-qv-modal {
  position: fixed;
  inset: 0;
  z-index: 9000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bs-qv-modal[hidden] {
  display: none;
}

.bs-qv-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  animation: bs-fade-in 250ms ease both;
}

.bs-qv-panel {
  position: relative;
  z-index: 1;
  background: #fff;
  width: min(680px, calc(100vw - 32px));
  max-height: calc(100vh - 64px);
  overflow-y: auto;
  padding: 40px 36px;
  animation: bs-slide-up 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.bs-qv-close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 32px;
  height: 32px;
  background: none;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1a1a1a;
  transition: opacity 180ms ease;
  outline: none;
}

.bs-qv-close:hover { opacity: 0.6; }
.bs-qv-close:focus-visible { outline: 2px solid #1a1a1a; }
.bs-qv-close svg { width: 20px; height: 20px; }

.bs-qv-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 48px 0;
}

.bs-qv-spinner span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #1a1a1a;
  animation: bs-dot-pulse 1.2s infinite ease-in-out;
}

.bs-qv-spinner span:nth-child(2) { animation-delay: 0.18s; }
.bs-qv-spinner span:nth-child(3) { animation-delay: 0.36s; }

/* ── Keyframes ───────────────────────────────────────────── */
@keyframes bs-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes bs-slide-up {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes bs-dot-pulse {
  0%, 80%, 100% { opacity: 0.2; transform: scale(0.8); }
  40%            { opacity: 1;   transform: scale(1);   }
}

/* ── Reduced Motion ──────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .bs-card__img,
  .bs-card__showcase,
  .bs-card__showcase-video,
  .bs-card__quickview,
  .bs-card__title { transition: none !important; }
  .bs-qv-backdrop,
  .bs-qv-panel { animation: none !important; }
}

/* ── Tablet — 2 Columns ──────────────────────────────────── */
@media screen and (max-width: 1024px) {
  .bs-container { padding: 0 24px; }
  .bs-section { --bs-pt: 56px; --bs-pb: 64px; }
  .bs-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
}

/* ── Mobile — Horizontal Swipe ───────────────────────────── */
@media screen and (max-width: 767px) {
  .bs-container { padding: 0; max-width: 100%; }
  .bs-section { --bs-pt: 44px; --bs-pb: 52px; }
  .bs-header { padding: 0 20px; margin-bottom: 28px; }

  .bs-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 12px;
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 20px;
    padding: 0 20px 20px;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .bs-grid::-webkit-scrollbar { display: none; }

  .bs-card {
    flex: 0 0 72vw;
    max-width: 300px;
    min-width: 220px;
    scroll-snap-align: start;
  }

  .bs-card__quickview {
    opacity: 1;
    transform: translateY(0);
  }

  /* On touch devices there is no hover, so static showcase mode always shows
     the custom image and hover-reveal showcase falls back to the primary image. */
  .bs-card__showcase,
  .bs-card__showcase-video {
    transition: none;
  }

  .bs-badge { font-size: 9.5px; padding: 3px 9px; }
}

@media screen and (max-width: 390px) {
  .bs-card { flex: 0 0 80vw; }
}
