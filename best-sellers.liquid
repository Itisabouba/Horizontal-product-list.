{% comment %}
  BEST SELLERS — Shopify OS 2.0 Section
{% endcomment %}

{%- liquid
  assign section_id        = section.id
  assign heading           = section.settings.heading
  assign products          = section.settings.collection.products
  assign product_limit     = section.settings.product_limit | default: 6
  assign bg_color          = section.settings.background_color
  assign heading_color     = section.settings.heading_color
  assign low_stock_thresh  = section.settings.low_stock_threshold | plus: 0
-%}

<section
  id="best-sellers-{{ section_id }}"
  class="bs-section"
  style="
    --bs-bg: {{ bg_color }};
    --bs-heading-color: {{ heading_color }};
    --bs-pt: {{ section.settings.padding_top }}px;
    --bs-pb: {{ section.settings.padding_bottom }}px;
  "
  aria-label="{{ heading | escape }}"
>
  <div class="bs-container">

    <header class="bs-header">
      <h2 class="bs-heading">{{ heading | escape }}</h2>
    </header>

    <div class="bs-grid" role="list">

      {%- if products != blank -%}
        {%- for product in products limit: product_limit -%}

          {%- liquid
            assign primary_img   = product.featured_image
            assign secondary_img = product.images[1]
            assign vendor        = product.vendor
            assign title         = product.title
            assign price         = product.price | money
            assign compare_price = product.compare_at_price | money
            assign has_compare   = false
            if product.compare_at_price > product.price
              assign has_compare = true
            endif
            assign badge_meta    = product.metafields.custom.badges.value
            assign inv_qty       = product.selected_or_first_available_variant.inventory_quantity
            assign inv_mgmt      = product.selected_or_first_available_variant.inventory_management
            assign show_low_stock = false
            if inv_mgmt == 'shopify'
              if inv_qty > 0 and inv_qty <= low_stock_thresh
                assign show_low_stock = true
              endif
            endif
          -%}

          <article class="bs-card" role="listitem">

            
              href="{{ product.url }}"
              class="bs-card__image-link"
              aria-label="{{ title | escape }}"
            >
              <div class="bs-card__image-wrap">

                {%- if primary_img -%}
                  {{
                    primary_img
                    | image_url: width: 900
                    | image_tag:
                      class: 'bs-card__img bs-card__img--primary',
                      loading: 'lazy',
                      widths: '400, 600, 800, 900',
                      sizes: '(max-width: 767px) 90vw, (max-width: 1024px) 48vw, 33vw',
                      alt: primary_img.alt | default: title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'bs-card__img bs-card__img--primary bs-card__img--placeholder' }}
                {%- endif -%}

                {%- if secondary_img -%}
                  {{
                    secondary_img
                    | image_url: width: 900
                    | image_tag:
                      class: 'bs-card__img bs-card__img--secondary',
                      loading: 'lazy',
                      widths: '400, 600, 800, 900',
                      sizes: '(max-width: 767px) 90vw, (max-width: 1024px) 48vw, 33vw',
                      alt: secondary_img.alt | default: title
                  }}
                {%- endif -%}

                <div class="bs-card__badges" aria-label="Product badges">
                  {%- if badge_meta != blank -%}
                    {%- for badge_key in badge_meta -%}
                      {%- liquid
                        case badge_key
                          when 'hot_seller'
                            assign badge_label = 'Hot Seller'
                            assign badge_mod   = 'hot'
                          when 'restocked'
                            assign badge_label = 'Restocked'
                            assign badge_mod   = 'restocked'
                          when 'low_stock'
                            assign badge_label = 'Low Stock!'
                            assign badge_mod   = 'low'
                          when 'limited_edition'
                            assign badge_label = 'Limited Edition'
                            assign badge_mod   = 'limited'
                          when 'new_arrival'
                            assign badge_label = 'New Arrival'
                            assign badge_mod   = 'new'
                          when 'sale'
                            assign badge_label = 'Sale'
                            assign badge_mod   = 'sale'
                          else
                            assign badge_label = badge_key
                            assign badge_mod   = 'default'
                        endcase
                      -%}
                      <span class="bs-badge bs-badge--{{ badge_mod }}">{{ badge_label }}</span>
                    {%- endfor -%}
                  {%- else -%}
                    {%- if product.tags contains 'hot-seller' or product.tags contains 'hot_seller' -%}
                      <span class="bs-badge bs-badge--hot">Hot Seller</span>
                    {%- endif -%}
                    {%- if product.tags contains 'restocked' -%}
                      <span class="bs-badge bs-badge--restocked">Restocked</span>
                    {%- endif -%}
                    {%- if product.tags contains 'limited-edition' or product.tags contains 'limited_edition' -%}
                      <span class="bs-badge bs-badge--limited">Limited Edition</span>
                    {%- endif -%}
                    {%- if product.tags contains 'new-arrival' or product.tags contains 'new_arrival' -%}
                      <span class="bs-badge bs-badge--new">New Arrival</span>
                    {%- endif -%}
                    {%- if show_low_stock -%}
                      <span class="bs-badge bs-badge--low">Low Stock!</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>

                <button
                  type="button"
                  class="bs-card__quickview"
                  data-product-url="{{ product.url }}"
                  aria-label="Quick view {{ title | escape }}"
                >
                  {% render 'icon-quick-view' %}
                </button>

              </div>
            </a>

            <button
              type="button"
              class="bs-card__wishlist"
              data-product-id="{{ product.id }}"
              aria-label="Add {{ title | escape }} to wishlist"
              aria-pressed="false"
            >
              <svg class="bs-wishlist-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>

            <div class="bs-card__info">
              <a href="{{ product.url }}" class="bs-card__title-link">
                <h3 class="bs-card__title">{{ title | escape }}</h3>
              </a>
              {%- if section.settings.show_vendor and vendor != blank -%}
                <p class="bs-card__vendor">{{ vendor | escape }}</p>
              {%- endif -%}
              <div class="bs-card__price-row">
                <span class="bs-card__price">{{ price }}</span>
                {%- if has_compare -%}
                  <s class="bs-card__compare-price">{{ compare_price }}</s>
                {%- endif -%}
              </div>
              {%- if show_low_stock -%}
                <p class="bs-card__low-stock">only {{ inv_qty }} left</p>
              {%- endif -%}
            </div>

          </article>

        {%- endfor -%}

      {%- else -%}

        {%- for i in (1..3) -%}
          <article class="bs-card bs-card--placeholder" role="listitem">
            <div class="bs-card__image-link" aria-hidden="true">
              <div class="bs-card__image-wrap">
                {{ 'product-1' | placeholder_svg_tag: 'bs-card__img bs-card__img--primary bs-card__img--placeholder' }}
                <div class="bs-card__badges">
                  <span class="bs-badge bs-badge--hot">Hot Seller</span>
                </div>
                <button type="button" class="bs-card__quickview" disabled aria-label="Quick view">
                  {% render 'icon-quick-view' %}
                </button>
              </div>
            </div>
            <button type="button" class="bs-card__wishlist" disabled aria-label="Add to wishlist">
              <svg class="bs-wishlist-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
            <div class="bs-card__info">
              <p class="bs-card__title">Product Title Placeholder</p>
              <p class="bs-card__vendor">Brand Name</p>
              <div class="bs-card__price-row">
                <span class="bs-card__price">$199.00</span>
              </div>
            </div>
          </article>
        {%- endfor -%}

      {%- endif -%}

    </div>
  </div>
</section>

<div id="bs-quickview-modal" class="bs-qv-modal" role="dialog" aria-modal="true" aria-labelledby="bs-qv-title" hidden>
  <div class="bs-qv-backdrop" id="bs-qv-backdrop"></div>
  <div class="bs-qv-panel">
    <button type="button" class="bs-qv-close" id="bs-qv-close" aria-label="Close quick view">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <div class="bs-qv-body" id="bs-qv-body">
      <div class="bs-qv-spinner" aria-label="Loading"><span></span><span></span><span></span></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "bs-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of Products",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor Name",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low Stock Threshold (units)",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "category": "Collection"
    }
  ]
}
{% endschema %}
